<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) data extraction rules. Google Play / the OS
  use this to decide what to copy off the device during a backup or
  device-to-device transfer.

  - We disable backups entirely (allowBackup="false" in manifest)
    so this file only governs device-to-device transfer.
  - Sensitive data (auth tokens, profile photos) is excluded from
    cloud backup and from device-to-device transfer.

  Required by Play Store Console for any data safety submission that
  flags "Data can be transferred off device" = true.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Disable cloud backup entirely — we hold auth tokens in
             native secure storage; we don't want them in Google Drive. -->
    </cloud-backup>
    <device-transfer>
        <!-- Allow profile data (display name, photos, interests,
             prompts) to transfer to a new device, but exclude auth
             tokens — those are re-issued on login. -->
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
        <exclude domain="sharedpref" path="simp_access.xml" />
        <exclude domain="sharedpref" path="simp_refresh.xml" />
    </device-transfer>
</data-extraction-rules>
