<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security policy. Required by Google Play for apps that target
  Android 9+ (API 28+) and don't use cleartext HTTP.

  - production traffic goes over HTTPS to render.com, so no
    cleartext-traffic exception is needed for that
  - localhost exception is included for the dev backend (npx cap run
    android --host) only; remove before publishing to the Play Store
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Cleartext ONLY for the dev loopback address, used by
         `cap run android --host`. Play Store will warn about this; the
         release build path explicitly excludes this allowlist via the
         gradle product flavor (see android/app/build.gradle). -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
</network-security-config>
