<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. Matches the dark-gold brand. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:background">@color/ink_950</item>
        <item name="android:windowBackground">@color/ink_950</item>
        <item name="android:statusBarColor">@color/ink_950</item>
        <item name="android:navigationBarColor">@color/ink_950</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Splash launch theme — used by Android 12+ splash screen API.
         The icon is the same gold crown-on-ink mark used by the PWA. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ink_950</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>
