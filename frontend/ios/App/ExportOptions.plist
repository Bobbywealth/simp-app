<?xml version="1.0" encoding="UTF-8"?>
<!--
  ExportOptions.plist for SIMP App Store distribution.

  This file is committed for documentation + a sane default for manual Xcode
  archives, but the GitHub Actions workflow overwrites it at runtime with the
  real team ID sourced from the APPLE_TEAM_ID secret. See .github/workflows/ios-build.yml.

  Keys:
  - method = app-store-connect → produces a signed .ipa ready for App Store Connect upload
  - signingStyle = manual → matches the imported Apple Distribution cert + provisioning profile
  - teamID → replace with Bobby's actual 10-char team ID before any local archive
  - provisioningProfiles → maps the bundle ID to the "SIMP App Store" profile
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>method</key>
    <string>app-store-connect</string>
    <key>destination</key>
    <string>export</string>
    <key>signingStyle</key>
    <string>manual</string>
    <key>teamID</key>
    <string>REPLACE_WITH_APPLE_TEAM_ID</string>
    <key>uploadSymbols</key>
    <true/>
    <key>uploadBitcode</key>
    <false/>
    <key>signingCertificate</key>
    <string>Apple Distribution</string>
    <key>provisioningProfiles</key>
    <dict>
        <key>app.simp.client</key>
        <string>SIMP App Store</string>
    </dict>
</dict>
</plist>
