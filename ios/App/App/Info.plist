<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    This file is auto-generated by Capacitor on `cap sync`. The values
    below are the ones Apple App Store review specifically checks; edit
    only if you change permissions / behavior, then re-run `cap sync`.

    Most of these strings appear verbatim in the iOS permission prompt
    shown to the user. Apple rejects apps that have an empty
    `NS*UsageDescription` for any permission they actually request.
  -->

  <key>CFBundleDevelopmentRegion</key>
  <string>$(DEVELOPMENT_LANGUAGE)</string>
  <key>CFBundleDisplayName</key>
  <string>SIMP</string>
  <key>CFBundleExecutable</key>
  <string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleIdentifier</key>
  <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>$(PRODUCT_NAME)</string>
  <key>CFBundlePackageType</key>
  <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
  <key>CFBundleShortVersionString</key>
  <string>$(MARKETING_VERSION)</string>
  <key>CFBundleVersion</key>
  <string>$(CURRENT_PROJECT_VERSION)</string>

  <!-- Required: camera access for live streaming. -->
  <key>NSCameraUsageDescription</key>
  <string>SIMP uses the camera so you can broadcast a live stream and capture profile photos. You stay in control — the camera only activates when you start a stream or take a photo.</string>

  <!-- Required: microphone access for live streaming. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>SIMP uses the microphone so you can be heard on your live stream and in voice messages. Audio capture only happens when you explicitly start a stream.</string>

  <!-- Required: photo library access for selecting profile photos. -->
  <key>NSPhotoLibraryUsageDescription</key>
  <string>SIMP needs access to your photo library so you can pick profile photos to upload.</string>

  <!-- Required if you save captured images back to the photo library. -->
  <key>NSPhotoLibraryAddUsageDescription</key>
  <string>SIMP saves captured photos to your library when you explicitly tap "Save".</string>

  <!-- Location for distance-based matching. Only requested when the user
       enables location-aware discovery. -->
  <key>NSLocationWhenInUseUsageDescription</key>
  <string>SIMP uses your approximate location to suggest people nearby. You can disable location in Settings at any time.</string>

  <!-- App Tracking Transparency — required if you use IDFA or any
       cross-app tracking. SIMP does NOT track users across apps, but
       the key is declared for future-proofing and Apple's review. -->
  <key>NSUserTrackingUsageDescription</key>
  <string>This data is only used to deliver your in-app experience and is never shared with third parties.</string>

  <!-- Local network for WebRTC peer discovery. -->
  <key>NSLocalNetworkUsageDescription</key>
  <string>SIMP needs local network access to connect you directly with other users' live streams for low-latency video.</string>

  <!-- Background audio (so live streams keep playing when the app is
       backgrounded briefly). -->
  <key>UIBackgroundModes</key>
  <array>
    <string>audio</string>
  </array>

  <!-- We don't use exempt encryption (no custom ciphers); App Store
       upload form will skip the CCATS question. -->
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>

  <!-- Universal links / deep links. App links for password reset etc. -->
  <key>apple-app-site-association</key>
  <dict>
    <key>applinks</key>
    <dict>
      <key>apps</key>
      <array/>
      <key>details</key>
      <array>
        <dict>
          <key>appIDs</key>
          <array>
            <string>TEAMID.app.simp.client</string>
          </array>
          <key>components</key>
          <array>
            <dict>
              <key>/</key>
              <string>/</string>
              <key>comment</key>
              <string>SIMP main universal link host</string>
            </dict>
          </array>
        </dict>
      </array>
    </dict>
  </dict>

  <!-- Transport security: allow HTTPS only (default). Explicit ATS
       exception for the (dev) localhost backend is handled via
       NSAllowsLocalNetworking = true; production uses HTTPS to the
       render.com backend so no ATS exception is needed. -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsArbitraryLoads</key>
    <false/>
    <key>NSAllowsLocalNetworking</key>
    <true/>
  </dict>

  <!-- URL scheme for deep links (simP://...). -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>app.simp.client</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>simP</string>
      </array>
    </dict>
  </array>

  <!-- Status bar / launch screen style. -->
  <key>UIStatusBarStyle</key>
  <string>UIStatusBarStyleLightContent</string>
  <key>UIViewControllerBasedStatusBarAppearance</key>
  <true/>

  <!-- Required since iOS 14 — explicit orientation support so we don't
       get rejected for "iPad orientation missing" during review. -->
  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
  </array>
  <key>UISupportedInterfaceOrientations~ipad</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationPortraitUpsideDown</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>

  <!-- Minimum iOS version — 14 is current App Store floor. -->
  <key>MinimumOSVersion</key>
  <string>14.0</string>

  <!-- Required by Apple for any in-app purchase / StoreKit integration. -->
  <key>SKAdNetworkItems</key>
  <array>
    <dict>
      <key>SKAdNetworkIdentifier</key>
      <string>cstr6suwn9.skadnetwork</string>
    </dict>
  </array>
</dict>
</plist>
