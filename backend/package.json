{
  "name": "simp-app-backend",
  "version": "0.3.0-rc.1",
  "private": true,
  "description": "SIMP dating app backend — Express + Postgres + Prisma + JWT",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "generate:vapid": "tsx scripts/generate-vapid-keys.ts",
    "smoke": "tsx scripts/smoke-test.ts",
    "reconcile:apple": "tsx scripts/reconcile-apple.ts",
    "reconcile:google": "tsx scripts/reconcile-google.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src prisma --ext .ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "seed:demo-account": "tsx scripts/seed-demo-account.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^10.0.0",
    "@sentry/profiling-node": "^10.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "firebase-admin": "^14.2.0",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "livekit-server-sdk": "^2.18.0",
    "multer": "^2.2.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "prisma": "^5.22.0",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "supertest": "^7.2.2",
    "vitest": "^4.1.11"
  }
}
