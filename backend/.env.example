# Environment
NODE_ENV=development
PORT=4000

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Database (Postgres). On Render, provision a Postgres instance and set DATABASE_URL.
DATABASE_URL=postgresql://user:password@localhost:5432/simp_app?schema=public

# JWT
JWT_ACCESS_SECRET=replace-with-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
