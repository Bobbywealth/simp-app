NODE_ENV=development
PORT=4000
APP_VERSION=0.3.0-rc.1
ALLOWED_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/simp
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
IP_HASH_SECRET=replace-with-a-random-audit-hash-secret
PUBLIC_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# Persistent photos. Production requires cloudinary.
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=simp/profile-photos

# Email verification/password reset: disabled | console (development only) | resend | webhook
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@mysimp.com
RESEND_API_KEY=
EMAIL_WEBHOOK_URL=

# Native push: disabled | firebase | webpush
PUSH_PROVIDER=webpush
FIREBASE_SERVICE_ACCOUNT_JSON=

# Web Push (VAPID) keys. Required when PUSH_PROVIDER=webpush.
# Generate via: npx tsx scripts/generate-vapid-keys.ts
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@mysimp.com

STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_PROVIDER=

# SIMP is fully free — there is no paid subscription or IAP. The free
# tier caps are FREE_DAILY_LIKES / FREE_DAILY_SUPER_LIKES. APPLE_CLIENT_ID
# is the only Apple-side env var still required (Sign in with Apple).
FREE_DAILY_LIKES=25
FREE_DAILY_SUPER_LIKES=1
APPLE_BUNDLE_ID=app.simp.client
APPLE_CLIENT_ID=

FEATURE_EXPERIENCES=false
SENTRY_DSN=
ANALYTICS_ENDPOINT=
ANALYTICS_WRITE_KEY=
