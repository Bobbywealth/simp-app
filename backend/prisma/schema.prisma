// Canonical Prisma schema for the SIMP dating, messaging, live, and
// safety platform. SIMP is fully free — there are no entitlements or
// paid-feature gates at the database layer. Historical migrations
// remain immutable; release-candidate additions live in later
// migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  WOMAN
  MAN
  NONBINARY
  PREFER_NOT_TO_SAY
}

enum LookingFor {
  WOMEN
  MEN
  EVERYONE
}

enum SwipeAction {
  PASS
  LIKE
  SUPERLIKE
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  APPLE_ACCOUNT_MERGE
}

enum SocialProvider {
  APPLE
  GOOGLE
}

enum VerificationStatus {
  NOT_REQUESTED
  PENDING
  APPROVED
  REJECTED
}

enum MessageType {
  TEXT
  IMAGE
  SYSTEM
}

enum ReportCategory {
  HARASSMENT
  HATE_SPEECH
  SCAM
  IMPERSONATION
  FAKE_PROFILE
  INAPPROPRIATE_SEXUAL_CONTENT
  UNDERAGE_USER
  THREAT_VIOLENCE
  SPAM
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWING
  ACTIONED
  DISMISSED
}

enum NotificationType {
  MATCH
  MESSAGE
  LIKE
  SYSTEM
  LIVE
  SECURITY
}

enum PushPlatform {
  IOS
  ANDROID
  WEB
}

enum ModerationActionType {
  WARN
  SUSPEND
  BAN
  RESTORE
  REMOVE_PHOTO
  END_STREAM
  APPROVE_VERIFICATION
  REJECT_VERIFICATION
}

enum LiveStreamStatus {
  LIVE
  ENDED
}

enum LiveReactionType {
  HEART
}

enum ExperienceCategory {
  DINNER
  DRINKS
  EVENT
  CONCERT
  TRAVEL
  SHOPPING
  ADVENTURE
  VIP
  OTHER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  emailVerified         Boolean       @default(false)
  emailVerifiedAt       DateTime?
  // Tracks the most recent hard-bounce or spam-complaint from the
  // transactional email provider. Used to flag accounts that should
  // update their email and to suppress further sends until they do.
  emailBounceAt         DateTime?
  emailBounceType       String?
  role                  UserRole      @default(USER)
  status                AccountStatus @default(ACTIVE)
  statusReason          String?
  suspendedUntil        DateTime?
  bannedAt              DateTime?
  deletedAt             DateTime?
  failedLoginAttempts   Int           @default(0)
  lockedUntil           DateTime?
  presence              String        @default("online")
  onboardingState       Json?
  onboardingStep        Int           @default(0)
  onboardingCompletedAt DateTime?

  profile                   Profile?
  discoveryPreference       DiscoveryPreference?
  photos                    Photo[]
  refreshTokens             RefreshToken[]
  authActionTokens          AuthActionToken[]
  socialIdentities          SocialIdentity[]
  interests                 UserInterest[]
  swipesMade                Swipe[]                      @relation("SwipesMade")
  swipesReceived            Swipe[]                      @relation("SwipesReceived")
  matchesAsA                Match[]                      @relation("MatchesAsA")
  matchesAsB                Match[]                      @relation("MatchesAsB")
  prompts                   Prompt[]
  messagesSent              Message[]
  blocksMade                Block[]                      @relation("BlocksMade")
  blocksReceived            Block[]                      @relation("BlocksReceived")
  reportsMade               Report[]                     @relation("ReportsMade")
  reportsReceived           Report[]                     @relation("ReportsReceived")
  reportsReviewed           Report[]                     @relation("ReportModerator")
  streamsBroadcast          LiveStream[]                 @relation("StreamsBroadcast")
  liveChatMessages          LiveChatMessage[]
  liveReactions             LiveReaction[]
  liveModerationsReceived   LiveModeration[]             @relation("LiveModeratedUser")
  liveModerationsMade       LiveModeration[]             @relation("LiveModerator")
  notifications             Notification[]               @relation("NotificationRecipient")
  notificationActions       Notification[]               @relation("NotificationActor")
  notificationPreference    NotificationPreference?
  pushTokens                PushToken[]
  emailEvents               EmailEvent[]
  analyticsEvents           AnalyticsEvent[]
  dailyUsages               DailyUsage[]
  moderationActionsTaken    ModerationAction[]           @relation("ModeratorActions")
  moderationActionsReceived ModerationAction[]           @relation("TargetActions")
  verificationRequests      ProfileVerificationRequest[] @relation("VerificationSubject")
  verificationReviews       ProfileVerificationRequest[] @relation("VerificationReviewer")
  broadcastsSent            Broadcast[]                  @relation("BroadcastActor")
  tosAcceptances            TosAcceptance[]

  // Required before broadcasting. Birthdate eligibility is separately
  // enforced when the profile is created or changed.
  ageConfirmedAt DateTime?
  ageConfirmedIp String?

  @@index([status, createdAt])
  @@index([role])
}

model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName String
  bio         String?
  birthDate   DateTime
  gender      Gender
  lookingFor  LookingFor
  city        String?
  occupation  String?
  heightCm    Int?

  // isVerified is the delivery-compatible cache used by existing clients.
  // It may only be changed by the verification moderation service.
  isVerified         Boolean            @default(false)
  verificationStatus VerificationStatus @default(NOT_REQUESTED)
  profileCompletedAt DateTime?

  // Up to 3 short user-typed interest labels (separate from the
  // curated Interest table). Shown alongside curated interests on
  // the profile and Discover cards. Sanitized client-side; max 24
  // chars each.
  customInterests String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gender, birthDate])
  @@index([verificationStatus])
}

model DiscoveryPreference {
  id                  String    @id @default(cuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  minAge              Int       @default(18)
  maxAge              Int       @default(99)
  maxDistanceKm       Int?
  verifiedOnly        Boolean   @default(false)
  interestSlugs       String[]  @default([])
  locationLat         Float?
  locationLng         Float?
  locationPrecisionKm Int?
  locationUpdatedAt   DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

enum PhotoStatus {
  PENDING
  APPROVED
  REJECTED
}

model Photo {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String
  publicId  String?  @unique
  position  Int      @default(0)
  width     Int?
  height    Int?
  bytes     Int?
  mimeType  String?
  status    PhotoStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, position])
  @@index([status])
}

model Interest {
  id    String         @id @default(cuid())
  slug  String         @unique
  label String
  users UserInterest[]
}

model UserInterest {
  userId     String
  interestId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
  @@index([interestId])
}

model RefreshToken {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId        String
  tokenHash       String       @unique
  expiresAt       DateTime
  revokedAt       DateTime?
  replacedById    String?
  reuseDetectedAt DateTime?
  deviceId        String?
  deviceName      String?
  platform        PushPlatform @default(WEB)
  ipHash          String?
  userAgent       String?
  lastUsedAt      DateTime     @default(now())
  createdAt       DateTime     @default(now())

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
}

model AuthActionToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type, expiresAt])
}

// Social identity rows. Each provider has its own stable `subject` (Apple
// `sub`, Google `sub`); we never trust the raw email from the provider
// because Apple issues a private-relay address that can change. The User
// row owns the canonical account; identities can be linked / unlinked.
model SocialIdentity {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider      SocialProvider
  subject       String
  // Cached at link time. For Apple, this is the private relay address
  // (`xyz@privaterelay.appleid.com`); it is not used for login lookup.
  email         String?
  emailVerified Boolean        @default(false)
  displayName   String?
  // Provider-supplied raw user blob (decoded JWT `user` field for Apple,
  // Google ID token claims for Google). Stored for audit only.
  rawProfile    Json?
  linkedAt      DateTime       @default(now())
  lastSeenAt    DateTime       @default(now())

  @@unique([provider, subject])
  @@index([userId, provider])
}

model Swipe {
  id        String      @id @default(cuid())
  swiperId  String
  swipedId  String
  action    SwipeAction
  note      String?
  createdAt DateTime    @default(now())

  swiper User @relation("SwipesMade", fields: [swiperId], references: [id], onDelete: Cascade)
  swiped User @relation("SwipesReceived", fields: [swipedId], references: [id], onDelete: Cascade)

  @@unique([swiperId, swipedId])
  @@index([swiperId, createdAt])
  @@index([swipedId, action, createdAt])
}

model Match {
  id              String    @id @default(cuid())
  userAId         String
  userBId         String
  createdAt       DateTime  @default(now())
  lastMessageAt   DateTime?
  isActive        Boolean   @default(true)
  deactivatedAt   DateTime?
  deactivatedById String?

  userA        User          @relation("MatchesAsA", fields: [userAId], references: [id], onDelete: Cascade)
  userB        User          @relation("MatchesAsB", fields: [userBId], references: [id], onDelete: Cascade)
  conversation Conversation?

  @@unique([userAId, userBId])
  @@index([userAId, isActive, lastMessageAt])
  @@index([userBId, isActive, lastMessageAt])
}

model Conversation {
  id        String    @id @default(cuid())
  matchId   String    @unique
  match     Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  clientId       String?
  body           String
  messageType    MessageType  @default(TEXT)
  imageUrl       String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deliveredAt    DateTime?
  readAt         DateTime?
  deletedAt      DateTime?

  @@unique([conversationId, clientId])
  @@index([conversationId, createdAt, id])
  @@index([senderId, createdAt])
  @@index([conversationId, readAt])
}

model Prompt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, position])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model Report {
  id                  String         @id @default(cuid())
  reporterId          String?
  reportedId          String?
  streamId            String?
  category            ReportCategory @default(OTHER)
  reason              String
  details             String?
  status              ReportStatus   @default(OPEN)
  moderatorId         String?
  moderatorNotes      String?
  contextKey          String?
  reporterFingerprint String?
  reportedFingerprint String?
  createdAt           DateTime       @default(now())
  reviewedAt          DateTime?
  actionedAt          DateTime?

  reporter  User?       @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: SetNull)
  reported  User?       @relation("ReportsReceived", fields: [reportedId], references: [id], onDelete: SetNull)
  moderator User?       @relation("ReportModerator", fields: [moderatorId], references: [id], onDelete: SetNull)
  stream    LiveStream? @relation(fields: [streamId], references: [id], onDelete: SetNull)

  @@unique([reporterId, contextKey])
  @@index([status, createdAt])
  @@index([reporterId, createdAt])
  @@index([reportedId, status])
  @@index([streamId])
}

model ModerationAction {
  id                String               @id @default(cuid())
  moderatorId       String?
  targetUserId      String?
  targetFingerprint String?
  action            ModerationActionType
  reason            String
  metadata          Json?
  createdAt         DateTime             @default(now())

  moderator User? @relation("ModeratorActions", fields: [moderatorId], references: [id], onDelete: SetNull)
  target    User? @relation("TargetActions", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([targetUserId, createdAt])
  @@index([moderatorId, createdAt])
}

model ProfileVerificationRequest {
  id         String             @id @default(cuid())
  userId     String
  reviewerId String?
  status     VerificationStatus @default(PENDING)
  userNote   String?
  reviewNote String?

  // Image verification: the user submits a live selfie (captured in-app)
  // alongside a sequence of pose prompts. The selfie is stored in Cloudinary
  // (folder `simp/verification-selfies`) and shown side-by-side with the
  // user's existing profile photos in the moderator review UI. After review
  // (approved / rejected / cancelled) the selfie is deleted from storage.
  // Selfies are processed for moderator review only and are never used as
  // persistent biometric identifiers — see `deleteVerificationSelfie`.
  selfieUrl      String?
  selfiePublicId String?
  poseSequence   String[]   @default([])
  // Lightweight liveness hints captured client-side (e.g. face-moved-between-
  // frames boolean, capture timestamps). Free-form JSON; moderators can ignore.
  livenessHints  Json?

  createdAt  DateTime @default(now())
  reviewedAt DateTime?

  user     User  @relation("VerificationSubject", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("VerificationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model LivekitUsageSnapshot {
  id                      String   @id @default(cuid())
  participantMinutes      Float    @default(0)
  participantMinutesLimit Float    @default(0)
  recordingStorageGb      Float    @default(0)
  recordingStorageLimitGb Float    @default(0)
  egressGb                Float    @default(0)
  egressLimitGb           Float    @default(0)
  planName                String?
  createdAt               DateTime @default(now())

  @@index([createdAt])
}

model LiveStream {
  id                String           @id @default(cuid())
  broadcasterId     String
  title             String
  status            LiveStreamStatus @default(LIVE)
  viewerCount       Int              @default(0)
  heartCount        Int              @default(0)
  startedAt         DateTime         @default(now())
  endedAt           DateTime?
  // LiveKit egress state for moderator review + App Store / Play Store
  // trust-and-safety compliance. recordingEgressId is the LiveKit handle
  // (stopped when the stream ends); recordingUrl is the resolved S3
  // path once the egress is COMPLETE (filled by the post-stop hook).
  recordingEgressId String?
  recordingUrl      String?

  broadcaster  User              @relation("StreamsBroadcast", fields: [broadcasterId], references: [id], onDelete: Cascade)
  chatMessages LiveChatMessage[]
  reactions    LiveReaction[]
  moderations  LiveModeration[]
  reports      Report[]

  @@index([status, startedAt])
  @@index([broadcasterId, status])
}

model LiveChatMessage {
  id          String    @id @default(cuid())
  streamId    String
  senderId    String
  body        String
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  moderatedAt DateTime?

  stream LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  sender User       @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([streamId, createdAt, id])
  @@index([senderId, createdAt])
}

model LiveReaction {
  id        String           @id @default(cuid())
  streamId  String
  userId    String
  type      LiveReactionType @default(HEART)
  createdAt DateTime         @default(now())

  stream LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([streamId, createdAt])
  @@index([userId, createdAt])
}

model LiveModeration {
  id          String    @id @default(cuid())
  streamId    String
  userId      String
  moderatorId String
  mutedUntil  DateTime?
  removedAt   DateTime?
  reason      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  stream    LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  user      User       @relation("LiveModeratedUser", fields: [userId], references: [id], onDelete: Cascade)
  moderator User       @relation("LiveModerator", fields: [moderatorId], references: [id], onDelete: Cascade)

  @@unique([streamId, userId])
  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  actorId   String?
  type      NotificationType
  entityId  String?
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user  User  @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
}

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches   Boolean  @default(true)
  messages  Boolean  @default(true)
  likes     Boolean  @default(true)
  live      Boolean  @default(true)
  security  Boolean  @default(true)
  marketing Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PushToken {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String       @unique
  // Web Push subscription payload (endpoint + keys.p256dh + keys.auth).
  // Stored as JSON to keep the schema simple and let the backend resend
  // using the `web-push` library without re-deriving the structure.
  subscription Json?
  endpoint     String?      @unique
  deviceId     String?
  deviceName   String?
  platform     PushPlatform
  active       Boolean      @default(true)
  lastSeenAt   DateTime     @default(now())
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([userId, active])
  @@index([platform, active])
}

model DailyUsage {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day        DateTime @db.Date
  likes      Int      @default(0)
  superLikes Int      @default(0)
  rewinds    Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, day])
  @@index([day])
}

model Experience {
  id          String             @id @default(cuid())
  title       String
  description String?
  category    ExperienceCategory
  city        String
  startsAt    DateTime?
  priceCents  Int?
  currency    String             @default("USD")
  provider    String?
  capacity    Int?
  bookingUrl  String?
  imageUrl    String?
  isActive    Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([isActive, city, startsAt])
  @@index([category, startsAt])
}

/// Versioned Terms of Service / Privacy Policy documents.
model TosVersion {
  id          String   @id @default(cuid())
  type        String
  version     String
  summary     String
  content     String
  effectiveAt DateTime @default(now())

  acceptances TosAcceptance[]

  @@unique([type, version])
  @@index([type, effectiveAt])
}

model TosAcceptance {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tosVersionId String
  tosVersion   TosVersion @relation(fields: [tosVersionId], references: [id], onDelete: Cascade)
  type         String
  version      String
  acceptedAt   DateTime   @default(now())
  ipAddress    String?
  userAgent    String?

  @@index([userId, type, version])
}

model AssetDeletionJob {
  id            String    @id @default(cuid())
  publicId      String    @unique
  url           String?
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String?
  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  @@index([completedAt, nextAttemptAt])
}

model AccountDeletionReceipt {
  id              String   @id @default(cuid())
  userFingerprint String
  requestedAt     DateTime @default(now())
  completedAt     DateTime @default(now())
  photoCount      Int      @default(0)
  metadata        Json?

  @@index([completedAt])
}

/// Transactional email deliverability events. One row per provider
/// webhook delivery (delivered, bounced, complained, opened, clicked,
/// etc.) so we have an audit trail of every send. userId is nullable
/// because Resend webhooks can fire for recipients that aren't matched
/// to a User yet (e.g. waitlist addresses, test sends).
model EmailEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String
  type      String
  provider  String   @default("resend")
  subject   String?
  messageId String?
  payload   Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([type, createdAt])
}

/// Funnel analytics events. One row per client-side `track()` call.
/// Used by the admin funnel endpoint to compute conversion rates
/// (signup_started → signup_completed → first_swipe → first_match
/// → first_message → purchase_started → purchase_completed).
///
/// userId is nullable because signup_started fires before the user
/// exists (anonymous funnel start). sessionId lets us tie anonymous
/// events to the eventual user via the eventual track with userId.
///
/// Properties payload is application-defined per event. We never
/// store PII (email/name/photo/token/etc.) — the route-level Zod
/// validator rejects sensitive keys before this row is written.
model AnalyticsEvent {
  id         String   @id @default(cuid())
  event      String
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId  String?
  source     String   @default("client") // 'client' | 'server'
  appVersion String?
  properties Json?
  createdAt  DateTime @default(now())

  @@index([event, createdAt])
  @@index([userId, createdAt])
  @@index([sessionId])
  @@index([createdAt])
}

/// Admin broadcast log. One row per broadcast send event (one audience,
/// one title/body/route, one actor). The individual `Notification`
/// rows created for each recipient are NOT stored here — those live in
/// the regular Notification table so users can mark them read/delete
/// them. This table is the historical log the admin dashboard reads
/// to show "Bobby sent X to all users at 12:30pm → 1,245 delivered".
///
/// `audience` is a free-form string token (e.g. `all`, `verified`,
/// `pushable`, `role:USER`) so admins can see what slice they sent
/// to without needing to migrate a new enum per audience type.
model Broadcast {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("BroadcastActor", fields: [actorId], references: [id], onDelete: SetNull)
  audience   String
  title      String
  body       String
  route      String?
  data       Json?
  targeted   Int      @default(0)
  dispatched Int      @default(0)
  failed     Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
}
